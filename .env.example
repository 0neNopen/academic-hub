APP_NAME="Academic Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Pilihan Database: sqlite (Default lokal) atau pgsql (PostgreSQL / Supabase)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=academic_hub
# DB_USERNAME=postgres
# DB_PASSWORD=

# Contoh Koneksi Supabase Pooler:
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<your-project-ref>
# DB_PASSWORD=<your-supabase-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# File Storage: 'local' (Default disk lokal) atau 's3' (Cloudflare R2 / AWS S3)
FILESYSTEM_DISK=local

# Konfigurasi Cloudflare R2 / S3 Storage (Opsional, untuk Cloud Deployment)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=academic-hub-storage
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================================
# INTEGRASI NOTIFIKASI PENGINGAT DEADLINE TUGAS (REMINDER)
# ========================================================

# 1. Telegram Bot (100% Gratis & Resmi via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AcademicHubBot

# 2. WhatsApp Gateway (Pilihan Driver: green_api / waha)
WHATSAPP_DRIVER=green_api

# Driver Utama: Green-API (Cloud Gratis - 100 Pesan/Hari)
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Driver Alternatif: WAHA (Self-Hosted via Docker/Node - 100% Gratis Tanpa Batas)
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=

